{
  "manifest_version": 3,
  "name": "White Mode Buttons",
  "version": "1.0.0",
  "description": "Macht dunkle Buttons sichtbar im Dark Mode.",
  "author": "Dave Soysal (GermanusTV)",
  "homepage_url": "https://github.com/Germanen/white-mode-buttons",
  "permissions": [ "activeTab" ],
  "content_scripts": [
    {
      "matches": [ "<all_urls>" ],
      "js": [ "content.js" ]
    }
  ],
  "icons": {
    "48": "icon.png"
  }
}
